  "item": [
    {
      "name": "Search by keyword",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time below 500ms\", () => {\r",
              "  pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is an array\", () => {\r",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Results contain required fields if results exist\", () => {\r",
              "  const json = pm.response.json();\r",
              "\r",
              "  if (json.length > 0) {\r",
              "    pm.expect(json[0]).to.have.property(\"id\");\r",
              "    pm.expect(json[0]).to.have.property(\"title\");\r",
              "    pm.expect(json[0]).to.have.property(\"description\");\r",
              "    pm.expect(json[0]).to.have.property(\"tags\");\r",
              "  }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/search?q=test",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "test"
            }
          ]
        }
      },
      "response": []
    },
