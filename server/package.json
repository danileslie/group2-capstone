{
  "name": "peerconnect-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --rootDir .. --testMatch '**/tests/**/*.test.js'",
    "db:check": "node -e \"require('dotenv').config({ path: '../.env' }); require('./src/db/connection')().then(() => process.exit(0)).catch(err => { console.error(err.message); process.exit(1); })\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3"
  }
}
